{
  "name": "bugx-dsh-plugin",
  "version": "0.1.7",
  "description": "BugX autonomous code review and testing plugin for DSH: bundles bugx-cli, skills (/bugx, /bugx-dsh), /bugx-cli command, official MCP channels, and sidebar UI.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "bugx-cli": ">=0.1.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.1 <1.0.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.1 <1.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "skills/",
    "screenshots.json",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bugx",
    "mcp",
    "code-audit",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bencibr/bugx-dsh-plugin.git"
  },
  "homepage": "https://github.com/Bencibr/bugx-dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/Bencibr/bugx-dsh-plugin/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.0-rc.1 <1.0.0-0"
  },
  "license": "MIT"
}
